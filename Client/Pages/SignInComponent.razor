@page "/signin"
@using Shared.Entities
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject HttpClient Http
@using System.Net.Http.Json
@layout AuthLayout
@inject Blazored.LocalStorage.ILocalStorageService localStorage

<style>
    .container1 {
    background: var(--accent-color);
    padding: 0.3rem 0.3rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    width: 100%;
    max-width: 100%;
    text-align: center;
    color: #fff;
    min-height: 100vh;
    }

    .form-label {
    font-size: 0.8rem;
    margin-bottom: 0.2rem;
    }

    .form-control {
    border-radius: 5px;
    border: 1px solid #ddd;
    padding: 0.4rem;
    font-size: 0.85rem;
    height: 2.2rem;
    }

    .form-control:focus {
    border-color: #007bff;
    box-shadow: 0 0 3px rgba(0, 123, 255, 0.2);
    }

    .btn {
    padding: 0.5rem;
    font-size: 0.85rem;
    border-radius: 5px;
    transition: all 0.3s ease-in-out;
    height: 2.2rem;
    }

    .mb-3 {
    margin-bottom: 0.6rem !important;
    }

    .intro-section {
    padding: 1rem;
    }

    .row {
    min-height: 100vh;
    align-items: center;
    }

    .intro-section h2 {
    font-size: 1.6rem;
    }

    .intro-section p {
    font-size: 1rem;
    }

    .form-container {
    padding: 1.2rem 2.5rem;
    max-width: 80%;
    }
</style>

<div class="row g-0"> 
    <div class="col-12 col-md-6 d-none d-md-flex flex-column justify-content-center align-items-center text-center mb-4 mb-md-0">
        <div class="text-dark">
            <h2 class="welcome-heading fs-3 fs-lg-2">Welcome Back to DocDirect!</h2>
            <p class="welcome-description fs-5 fs-lg-4">Please sign in to access your account and manage appointments.</p>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="container1 d-flex justify-content-center align-items-center">
            <div>
                <h2 class="text-center text-white mb-2 fw-bolder">Sign In</h2>
                <p class="mb-3" style="font-size: 0.85rem;">Enter your credentials to access your account</p>
                <p class="mb-3" style="font-size: 0.85rem;">@Message</p>
                <EditForm Model="@signInModel" OnValidSubmit="HandleSignIn">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label for="email" class="form-label text-white fw-bold d-block text-start">Email</label>
                        <InputText id="email" type="email" class="form-control" @bind-Value="signInModel.Email" placeholder="Enter email" />
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label text-white fw-bold d-block text-start">Password</label>
                        <InputText id="password" type="password" class="form-control" @bind-Value="signInModel.Password" placeholder="Enter password" />
                    </div>

                    <div class="d-grid mb-2">
                        <button type="submit" class="btn btn-dark">Sign In</button>
                    </div>

                    <div class="d-grid mb-2">
                        <a href="/signup" class="btn btn-light text-dark">Don't have an account? Sign Up</a>
                    </div>
                    <div class="d-grid">
                        <a href="/" class="btn btn-dark">DocDirect</a>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>


@code {
    private SignInViewModel signInModel = new();
    private LoginResponse? result;
    private string? Message { get; set; } 

    protected override async Task OnInitializedAsync()
    {
        var userId = await localStorage.GetItemAsync<string>("userId");

        if (userId != null)
        {
            Navigation.NavigateTo("/patient-dashboard");
        }

        base.OnInitialized(); 
    }

    private async Task HandleSignIn()
    { 
        Message = "Loading...";

        try
        {
            // Call your API endpoint for patient sign-in
            var response = await Http.PostAsJsonAsync("api/AuthApi/login", signInModel); 

            if (response.IsSuccessStatusCode)
            {
                result = await response.Content.ReadFromJsonAsync<LoginResponse>(); 
                await localStorage.SetItemAsync("userId", result.UserId);
                await localStorage.SetItemAsync("email", result.Email);
                await localStorage.SetItemAsync("name", result.Name);
                await JS.InvokeVoidAsync("showSignInMessage");
                Navigation.NavigateTo("/patient-dashboard"); 
            }
            else
            {
                var errorJson = await response.Content.ReadAsStringAsync();
                Message = $"Sign-in failed: Invalid Email or Password";
            }
        }
        catch (Exception ex)
        {
            Message = "An error occurred: " + ex.Message;
        } 
    }
    public class LoginResponse
    {
        public string Message { get; set; }
        public string UserId { get; set; }
        public string Email { get; set; }
        public string Name { get; set; }
    } 

}
