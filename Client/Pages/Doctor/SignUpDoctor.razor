@page "/doctor-signup"
@using Shared.Entities
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject NavigationManager NavManager
@layout AuthLayout
<style>
    .container1 {
        background: var(--accent-color);
        padding: 0.3rem 0.3rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 100%;
        text-align: center;
        color: #fff;
        min-height: 100vh;
    }


    .form-label {
        font-size: 0.8rem;
        margin-bottom: 0.2rem;
    }

    .form-control {
        border-radius: 5px;
        border: 1px solid #ddd;
        padding: 0.4rem;
        font-size: 0.85rem;
        height: 2.2rem;
    }

        .form-control:focus {
            border-color: #007bff;
            box-shadow: 0 0 3px rgba(0, 123, 255, 0.2);
        }

    .btn {
        padding: 0.5rem;
        font-size: 0.85rem;
        border-radius: 5px;
        transition: all 0.3s ease-in-out;
        height: 2.2rem;
    }

    .mb-3 {
        margin-bottom: 0.6rem !important;
    }

    .intro-section {
        padding: 1rem;
    }

    .row {
        min-height: 100vh;
        align-items: center;
    }

    .intro-section h2 {
        font-size: 1.6rem;
    }

    .intro-section p {
        font-size: 1rem;
    }

    .form-container {
        padding: 1.2rem 2.5rem;
        max-width: 80%;
    }
</style>
<div class="row g-0">
    <div class="col-12 col-md-6 d-none d-md-flex flex-column justify-content-center align-items-center text-center mb-4 mb-md-0">
        <div class="text-dark">
            <h2 class="fs-3 fs-lg-2 fw-bold">Join DocDirect as a Doctor</h2>
            <p class="fs-5 fs-lg-4">Create your profile to manage appointments and help patients.</p>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="container1 d-flex justify-content-center align-items-center">
            <div>
                <h2 class="text-center text-white mb-2 fw-bolder">Create Account</h2>
                <p class="mb-3" style="font-size: 0.85rem;">Join our community of healthcare professionals</p>
                <p class="mb-3" style="font-size: 0.85rem;">@Message</p>
                <EditForm Model="@doctor" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="mb-3">
                        <label for="name" class="form-label text-white fw-bold d-block text-start">Name</label>
                        <InputText id="name" class="form-control" @bind-Value="doctor.Name" placeholder="Enter full name" />
                    </div>
                    <div class="mb-3">
                        <label for="specialization" class="form-label text-white fw-bold d-block text-start">Specialization</label>
                        <InputText id="specialization" class="form-control" @bind-Value="doctor.Specialization" placeholder="e.g. Cardiologist" />
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label text-white fw-bold d-block text-start">Email</label>
                        <InputText id="email" type="email" class="form-control" @bind-Value="doctor.Email" placeholder="Enter email" />
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label text-white fw-bold d-block text-start">Password</label>
                        <InputText id="password" type="password" class="form-control" @bind-Value="doctor.Password" placeholder="Enter password" />
                    </div>
                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label text-white fw-bold d-block text-start">Confirm Password</label>
                        <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="doctor.ConfirmPassword" placeholder="Confirm password" />
                    </div>
                    <div class="d-grid mb-2">
                        <button type="submit" class="btn btn-dark">Sign Up</button>
                    </div>
                    <div class="d-grid mb-2">
                        <a href="/doctor-signin" class="btn btn-light text-dark">Already have an account? Sign In</a>
                    </div>
                    <div class="d-grid">
                        <a href="/" class="btn btn-dark">DocDirect</a>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>
@inject IJSRuntime JS
@code {
    private DoctorRegisterModel doctor = new DoctorRegisterModel();
    private string Message { get; set; }
    private async Task HandleValidSubmit()
    {
        Message = "Loadding...";
        var response = await Http.PostAsJsonAsync("api/doctors/signup", doctor);
        if (response.IsSuccessStatusCode)
        {
            await JS.InvokeVoidAsync("showRegisterMessage");
            NavManager.NavigateTo("/doctor-signin");
        }
        else
        {
            // Read error details from response
            var errorContent = await response.Content.ReadAsStringAsync();

            // Show alert or display error message
            Message = $"Registration failed: {errorContent}";
        }
    }

}