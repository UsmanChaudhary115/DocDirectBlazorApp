@page "/admin-login"
@inject NavigationManager Navigation
@inject IJSRuntime JS
@layout AuthLayout
<style>

    /* Main container */
    .login-container {
        display: flex;
        width: 100%;
        max-width: 1100px;
        margin: auto;
        background-color: white;
    }

    /* Illustration section */
    .login-image {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .login-image img {
            width: 80%;
            max-width: 400px;
        }

    /* Form section */
    .login-form {
        flex: 1;
        padding: 60px 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .login-form h2 {
            color: #5b21b6;
            font-size: 32px;
            margin-bottom: 10px;
        }

        .login-form p {
            color: #6b7280;
            margin-bottom: 30px;
            font-size: 14px;
        }

    .input-group {
        margin-bottom: 20px;
    }

        .input-group label {
            display: block;
            font-size: 14px;
            margin-bottom: 5px;
            color: #374151;
        }

        .input-group input {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            transition: border 0.3s;
        }

            .input-group input:focus {
                border-color: #7c3aed;
                outline: none;
            }

    /* Remember + Forgot */
    .options-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 14px;
        margin-bottom: 20px;
    }

        .options-row a {
            color: #7c3aed;
            text-decoration: none;
        }

            .options-row a:hover {
                text-decoration: underline;
            }

    button.login-btn {
        background: linear-gradient(to right, #7c3aed, #5b21b6);
        color: white;
        padding: 12px;
        width: 100%;
        border: none;
        border-radius: 6px;
        font-weight: bold;
        font-size: 16px;
        cursor: pointer;
        transition: opacity 0.3s;
    }

        button.login-btn:hover {
            opacity: 0.9;
        }

    /* Error message */
    .error-message {
        color: #b91c1c;
        background-color: #fee2e2;
        padding: 10px;
        border: 1px solid #fca5a5;
        border-radius: 4px;
        font-size: 14px;
        margin-bottom: 15px;
    }


    @@keyframes fade-in {
        from

    {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes slide-down {
        from

    {
        opacity: 0;
        transform: translateY(-20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes slide-up {
        from

    {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .animate-fade-in {
        animation: fade-in 0.8s ease-out forwards;
    }

    .animate-slide-down {
        animation: slide-down 0.8s ease-out forwards;
    }

    .animate-slide-up {
        animation: slide-up 0.8s ease-out forwards;
    }
</style>


<div class="login-container">
    

    <!-- Right: Login form -->
    <div class="login-form">
        <h2>Log In</h2>
        <p>Log in with your data that you entered during your registration</p>

        <div class="input-group">
            <label>Username</label>
            <input @bind="Username" placeholder="admin name" />
        </div>

        <div class="input-group">
            <label>Password</label>
            <input @bind="Password" type="password" placeholder="password" />
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="error-message">@ErrorMessage</div>
        }

        <div class="options-row">
            <label><input type="checkbox" /> Keep me logged in</label>
            <a href="#">Forgot Password?</a>
        </div>

        <button class="login-btn" @onclick="HandleLogin">Login</button> 
        <a href="/" class="btn btn-primary mt-2">DocDirect</a>
    </div>
</div>

@code {
    private string Username;
    private string Password;
    private string ErrorMessage;

    private async Task HandleLogin()
    {
        if (Username.Trim().ToLower() == "admin" && Password.Trim() == "admin123")
        {
            var token = Guid.NewGuid().ToString();
            await JS.InvokeVoidAsync("localStorage.setItem", "authToken", token);
            await JS.InvokeVoidAsync("localStorage.setItem", "userRole", "admin");

            Navigation.NavigateTo("/admin-dashboard", forceLoad: true);
        }
        else
        {
            ErrorMessage = "Invalid username or password.";
        }
    }
}



